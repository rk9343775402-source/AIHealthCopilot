# Docker Compose PostgreSQL credentials (use a unique URL-safe local password).
POSTGRES_PASSWORD=replace-with-unique-url-safe-password

# Optional backend AI configuration.
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini

# Required for authentication. Generate a unique random value with at least 32 bytes.
AUTH_SECRET_KEY=
AUTH_TOKEN_EXPIRE_MINUTES=720
APP_ENV=development
